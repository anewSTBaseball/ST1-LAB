{
  "name": "Ubuntu Lab",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        // Hides the Explorer sidebar at startup
        "workbench.sideBar.location": "hidden",

        // Activity bar is optional; set to true if you want icons
        "workbench.activityBar.visible": false,

        // Prevent VS Code welcome tab from appearing
        "workbench.startupEditor": "none",

        // Make sure terminal stays visible & default to editor area
        "terminal.integrated.defaultLocation": "editor",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // Auto-open your instructions file
  "postCreateCommand": "code welcome.md"
}

